<Window x:Class="ADUserSearchTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD Benutzer Suche"
        Height="700"
        Width="1450"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/ad_benutzer_suche.ico">

    <Window.Resources>
        <Style x:Key="SelectableCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="AD Benutzer Suche"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

            <TextBox x:Name="txtSearch"
                     Width="420"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0"
                     ToolTip="Suchbegriff eingeben. Leer = alle Benutzer."
                     KeyDown="txtSearch_KeyDown"/>

            <ComboBox x:Name="cmbSearchMode"
                      Width="170"
                      Height="34"
                      Margin="0,0,10,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="Alle"/>
                <ComboBoxItem Content="Rufnummer"/>
                <ComboBoxItem Content="Logon Script"/>
                <ComboBoxItem Content="OU"/>
                <ComboBoxItem Content="Gruppe"/>
            </ComboBox>

            <ComboBox x:Name="cmbStatus"
                      Width="150"
                      Height="34"
                      Margin="0,0,10,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="Alle"/>
                <ComboBoxItem Content="Aktiv"/>
                <ComboBoxItem Content="Deaktiviert"/>
            </ComboBox>

            <Button x:Name="btnSearch"
                    Content="Suchen"
                    Width="100"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="btnSearch_Click"/>

            <Button x:Name="btnShowGroups"
                    Content="Mitglied von"
                    Width="120"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="btnShowGroups_Click"/>

            <Button x:Name="btnCopyRow"
                    Content="Zeile kopieren"
                    Width="120"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="btnCopyRow_Click"/>

            <Button x:Name="btnExport"
                    Content="Export Excel"
                    Width="120"
                    Height="34"
                    Margin="0,0,10,0"
                    Click="btnExport_Click"/>

            <Button x:Name="btnClear"
                    Content="Leeren"
                    Width="90"
                    Height="34"
                    Click="btnClear_Click"/>
        </StackPanel>

        <TextBlock x:Name="txtStatus"
                   Grid.Row="2"
                   Text="Bereit."
                   Foreground="Gray"
                   Margin="0,0,0,10"/>

        <DataGrid x:Name="dgResults"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  ClipboardCopyMode="IncludeHeader"
                  PreviewKeyDown="dgResults_PreviewKeyDown"
                  PreviewMouseRightButtonDown="dgResults_PreviewMouseRightButtonDown">

            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="dgResults_RowDoubleClick"/>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Auswahl kopieren"
                              Click="CopyDataGridSelection_Click"/>
                    <MenuItem Header="Zeile kopieren"
                              Click="CopySelectedRow_Click"/>
                    <MenuItem Header="Mitgliedschaften anzeigen"
                              Click="ShowGroupsFromContextMenu_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Name"
                                        Width="220"
                                        SortMemberPath="Name"
                                        ClipboardContentBinding="{Binding Name}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Benutzername"
                                        Width="140"
                                        SortMemberPath="Benutzername"
                                        ClipboardContentBinding="{Binding Benutzername}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Benutzername}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="E-Mail"
                                        Width="220"
                                        SortMemberPath="Email"
                                        ClipboardContentBinding="{Binding Email}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Email}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Telefon"
                                        Width="140"
                                        SortMemberPath="Telefon"
                                        ClipboardContentBinding="{Binding Telefon}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Telefon}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Mobile"
                                        Width="140"
                                        SortMemberPath="Mobile"
                                        ClipboardContentBinding="{Binding Mobile}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Mobile}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Logon Script"
                                        Width="150"
                                        SortMemberPath="LogonScript"
                                        ClipboardContentBinding="{Binding LogonScript}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding LogonScript}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Letzte Anmeldung"
                                        Width="160"
                                        SortMemberPath="LetzteAnmeldung"
                                        ClipboardContentBinding="{Binding LetzteAnmeldung}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding LetzteAnmeldung}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Mitglied von"
                                        Width="300"
                                        SortMemberPath="MitgliedVon"
                                        ClipboardContentBinding="{Binding MitgliedVon}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MitgliedVon}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status"
                                        Width="120"
                                        SortMemberPath="Status"
                                        ClipboardContentBinding="{Binding Status}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Status}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="OU"
                                        Width="260"
                                        SortMemberPath="OU"
                                        ClipboardContentBinding="{Binding OU}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding OU}"
                                     Style="{StaticResource SelectableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>